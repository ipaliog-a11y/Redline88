{
  "entities": {
    "PlayerSave": {
      "title": "PlayerSave",
      "description": "Private cloud garage, drivetrain tuning, and career progression save for a racer (no PII).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the save owner."
        },
        "callsign": {
          "type": "string",
          "minLength": 2,
          "maxLength": 18,
          "pattern": "^[a-zA-Z0-9 _\\-]+$",
          "description": "Public arcade racer callsign."
        },
        "cash": {
          "type": "number",
          "description": "Current in-game currency balance."
        },
        "activeCarId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Currently selected car identifier."
        },
        "highestUnlockedTier": {
          "type": "number",
          "description": "Highest unlocked racing tier (1 to 5)."
        },
        "ownedCars": {
          "type": "array",
          "description": "List of owned car IDs (max 30)."
        },
        "defeatedRivals": {
          "type": "array",
          "description": "List of defeated rival and challenge IDs (max 160)."
        },
        "carConfigs": {
          "type": "object",
          "description": "Map of carId to upgrade levels, visual customization, and drivetrain tuning (max 30)."
        },
        "totalWins": {
          "type": "number",
          "description": "Total career race victories."
        },
        "totalRaces": {
          "type": "number",
          "description": "Total career races completed."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when save was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when save was last updated."
        }
      },
      "required": [
        "ownerId",
        "callsign",
        "cash",
        "activeCarId",
        "highestUnlockedTier",
        "ownedCars",
        "defeatedRivals",
        "carConfigs",
        "totalWins",
        "totalRaces",
        "createdAt",
        "updatedAt"
      ]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "Public drag racing record for a racer in a specific tier and strip distance (zero PII).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "driverName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 18,
          "pattern": "^[a-zA-Z0-9 _\\-]+$",
          "description": "Arcade racer callsign displayed on the global leaderboard."
        },
        "tier": {
          "type": "number",
          "description": "Racing class tier from 1 (Street) to 5 (Top Fuel)."
        },
        "distance": {
          "type": "string",
          "enum": ["quarter", "half", "mile"],
          "description": "Drag strip distance (quarter = 1/4 mile, half = 1/2 mile, mile = 1 mile)."
        },
        "carId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Identifier of the car used in this run."
        },
        "carName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "description": "Display name of the car."
        },
        "etMs": {
          "type": "number",
          "description": "Strip elapsed time in milliseconds (lower is faster)."
        },
        "trapMph": {
          "type": "number",
          "description": "Trap speed at the finish line in MPH."
        },
        "reactionMs": {
          "type": "number",
          "description": "Launch reaction time in milliseconds."
        },
        "perfectShifts": {
          "type": "number",
          "description": "Count of perfect gear shifts during the run."
        },
        "paintColor": {
          "type": "string",
          "minLength": 4,
          "maxLength": 12,
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Hex color of the car paint for visual display."
        },
        "isPublic": {
          "type": "boolean",
          "description": "Must be true for public global leaderboard visibility."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of initial record submission."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of most recent record update."
        }
      },
      "required": [
        "uid",
        "driverName",
        "tier",
        "carId",
        "carName",
        "etMs",
        "trapMph",
        "reactionMs",
        "perfectShifts",
        "paintColor",
        "isPublic",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/playerSaves/{userId}": {
      "schema": {
        "$ref": "#/entities/PlayerSave"
      },
      "description": "Private cloud garage, drivetrain tuning, and economy save per authenticated user."
    },
    "/leaderboardEntries/{entryId}": {
      "schema": {
        "$ref": "#/entities/LeaderboardEntry"
      },
      "description": "Global drag racing leaderboard records (one best record per user per tier and strip distance)."
    }
  }
}
